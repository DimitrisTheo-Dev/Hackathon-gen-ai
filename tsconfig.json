{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "apps/web/src",
    "packages/contracts/src",
    "apps/web/vite.config.ts",
    "proxy.ts",
    "packages/public-api/src",
    "packages/cli/src",
    "packages/engine/src",
    "api",
    "apps/claude-runner",
    "apps/claude-routine"
  ]
}
