# ── Browser (public; bundled by Vite) ─────────────────────────────────────────
VITE_SUPABASE_URL=https://hgsgvdujzatfhsjoojll.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
# Optional. Leave empty: the studio calls the engine on its own origin (/v1/*).
VITE_CASTROOM_API_URL=
# Optional. The machines gateway (apps/machines) the /claude-login-test page connects to by default.
VITE_CLAUDE_GATEWAY_URL=https://faceful-machines.<your-subdomain>.workers.dev
# Optional for non-production preview builds only. Local dev enables fixtures at /dev/studio/.
CASTROOM_ENABLE_FIXTURES=false

# ── Engine (server only; set in Vercel → Project → Environment Variables, never VITE_) ──
SUPABASE_URL=https://hgsgvdujzatfhsjoojll.supabase.co
SUPABASE_SECRET_KEY=            # sb_secret_… ; server only, bypasses RLS
APP_BASE_URL=                   # public origin, e.g. https://faceful.vercel.app (MCP resource URL, Stripe return URLs)
CRON_SECRET=                    # random string; Vercel Cron sends it to /v1/cron/tick

# AI Creative Director. Without a key the director runs in "basic" mode (lookups, templates, exact edits).
GEMINI_API_KEY=                 # a Gemini API key (Google AI Studio); calls Google's Gemini API directly
ANTHROPIC_API_KEY=              # alternative: an Anthropic key. If both keys are set, Anthropic is used unless DIRECTOR_PROVIDER=gemini
AI_GATEWAY_API_KEY=             # alternative: a Vercel AI Gateway key
DIRECTOR_PROVIDER=              # optional: "gemini" when both keys are set; "vercel-gateway" uses the deployment's own OIDC token (the Vercel team needs AI Gateway credits/card)
DIRECTOR_MODEL=                 # optional; default gemini-4-hydrogen (Gemini), claude-opus-5-5 (Anthropic), anthropic/claude-opus-5.5 (gateway)
DIRECTOR_DAILY_TURNS=100        # model-backed director turns per workspace per 24h

# Rendering. Humanlike exposes realtime avatar sessions; a recording worker turns one into a file.
RENDER_WORKER_TOKEN=            # ≥32 random chars; shared with scripts/render-worker.ts. Unset = rendering not connected
RENDER_AVATARS=                 # optional JSON: [{"id":"minas_kontis","name":"Minas","languages":["en","el"]}]
HUMANLIKE_API_KEY=              # hk_live_… secret key; lists video-capable avatars when RENDER_AVATARS is unset
AVATAR_LANGUAGES=en,el          # languages the worker's voice supports
STARTER_RENDER_CREDITS=3
RENDER_CREDIT_COST=1

# Face scan ("Scan my face", /face-scan): a guided face scan and spoken consent, saved as private recordings.
# Private file storage on Cloudflare R2 (S3 API token with Object Read & Write on the bucket). Without these the
# capture runs but cannot save. The bucket needs a CORS rule allowing PUT from the app's origin with the headers
# content-type and x-amz-checksum-sha256.
FACEFUL_R2_ACCOUNT_ID=
FACEFUL_R2_ACCESS_KEY_ID=
FACEFUL_R2_SECRET_ACCESS_KEY=
FACEFUL_R2_BUCKET=faceful-media
STORAGE_QUOTA_BYTES=            # optional; bytes of draft files (pending + ready) one workspace may hold before upload links are refused. Default 5368709120 (5 GiB)
# Live transcription while the person reads aloud: Humanlike's /transcribe/live socket. This is the key Humanlike's
# server holds as TRANSCRIBE_ADMIN_KEY. Without it the capture uses the browser's own speech recognition.
HUMANLIKE_TRANSCRIBE_KEY=

# Publishing: YouTube (the one real destination). All three are required; otherwise channels report "not set up".
GOOGLE_OAUTH_CLIENT_ID=         # the Google OAuth client configured in Supabase Auth → Google (…apps.googleusercontent.com)
GOOGLE_OAUTH_CLIENT_SECRET=     # that client's secret; server only (refreshes channel access at upload time)
CONNECTIONS_ENCRYPTION_KEY=     # 32 random bytes, base64: `openssl rand -base64 32`. Encrypts stored channel grants; rotating it disconnects channels

# Social accounts (/v1/socials). Both unset: no account can be connected, nothing is posted, deliveries are refused.
# A workspace owner connects a provider with their own credentials (Buffer: an API key from Buffer → Settings → API),
# which are stored encrypted with this key. Changing the key means every workspace has to connect again.
SOCIALS_CREDENTIAL_KEY=         # 32 random bytes: `openssl rand -hex 32`
# Signs deliveries in the generic format to <APP_BASE_URL>/v1/socials/<platform>/webhook (header X-Faceful-Signature).
SOCIALS_WEBHOOK_SECRET=         # ≥32 random chars: `openssl rand -hex 32`
# Connecting Instagram directly (people sign in to Instagram; posts go out with no service in between). From the
# Meta app: Instagram → API setup with Instagram login → Business login settings. Add
# <APP_BASE_URL>/v1/socials/providers/instagram/callback there as an OAuth redirect URI. People connect at
# <APP_BASE_URL>/studio/connect/instagram. Needs SOCIALS_CREDENTIAL_KEY and APP_BASE_URL.
INSTAGRAM_LOGIN_APP_ID=         # "Instagram app ID" (numeric)
INSTAGRAM_LOGIN_APP_SECRET=     # "Instagram app secret" (not the Meta app secret below)
INSTAGRAM_LOGIN_SCOPES=         # optional; default asks for posting, comments and messages
# Connecting TikTok directly (people sign in to TikTok; videos go out through TikTok's Content Posting API). From the
# TikTok developer portal app: Login Kit + Content Posting API (Direct Post) products, and
# <APP_BASE_URL>/v1/socials/providers/tiktok/callback as a Login Kit redirect URI. People connect at
# <APP_BASE_URL>/studio/connect/tiktok. Needs TIKTOK_CLIENT_SECRET (below), SOCIALS_CREDENTIAL_KEY and APP_BASE_URL.
# Until TikTok audits the app, posts can only be private, to accounts that are set to private.
TIKTOK_CLIENT_KEY=              # "Client key" of the TikTok app
TIKTOK_LOGIN_SCOPES=            # optional; default user.info.basic,video.publish (add user.info.profile for @names)
# Posting to TikTok and Instagram through Humanlike as a partner (provider "humanlike"): Humanlike holds the accounts
# under its own reviewed TikTok and Instagram apps. Without these, a workspace can still paste a Humanlike workspace
# key (hlpk_…). With them, POST /v1/socials/providers/humanlike/connect with an empty body makes the workspace's own
# Humanlike workspace (named faceful-<workspace id>@<domain>) and keeps its key. From Humanlike's Admin > Partners.
HUMANLIKE_PARTNER_CLIENT_ID=    # hlpc_… (needs the "content" scope)
HUMANLIKE_PARTNER_CLIENT_SECRET= # hlps_…, shown once
HUMANLIKE_TENANT_EMAIL_DOMAIN=  # optional; default the host of APP_BASE_URL. Nothing is mailed to these addresses by Faceful
# Each platform's own webhooks, sent to the same address. They need an app registered with that platform; a
# platform left empty takes the generic format only. Register <APP_BASE_URL>/v1/socials/<platform>/webhook there.
INSTAGRAM_APP_SECRET=           # the Meta app's secret (App settings → Basic); signs Instagram deliveries
INSTAGRAM_WEBHOOK_VERIFY_TOKEN= # any string ≥8 chars; type the same one into the Meta app's webhook settings
WHATSAPP_APP_SECRET=            # the Meta app's secret for WhatsApp (can be the same app)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
TIKTOK_CLIENT_SECRET=           # the TikTok app's client secret; also signs in with TIKTOK_CLIENT_KEY above
LINKEDIN_CLIENT_SECRET=         # the LinkedIn app's client secret (needs LinkedIn's page-activity notifications)
# YouTube needs no app: the engine subscribes each connected channel at Google's hub, which signs with this.
YOUTUBE_WEBHOOK_SECRET=         # ≥32 random chars: `openssl rand -hex 32`

# Claude Code cloud machines (apps/machines). The page at /claude-login-test/ trades the Faceful session here for a
# ten-minute token that only the machines gateway accepts; the session itself never leaves Faceful.
MACHINES_GATEWAY_KEY=           # ≥32 random chars: `openssl rand -hex 32`; same value as the gateway's secret. "2:<new>,1:<old>" rotates
MACHINE_ALLOWED_USERS=          # comma-separated Faceful user ids that may have a machine; same list as the gateway's. Empty: nobody

# Stripe SANDBOX only. Live keys are rejected at boot. See STRIPE_SANDBOX_SETUP.md.
STRIPE_MODE=sandbox
STRIPE_SECRET_KEY=              # sk_test_… or rk_test_…
STRIPE_WEBHOOK_SECRET=          # whsec_… for <APP_BASE_URL>/v1/stripe/webhook
STRIPE_PRICE_ID_DEMO=           # price_… of a recurring sandbox Price
STRIPE_DEMO_PLAN_CREDITS=30     # render credits granted per paid invoice
