{
  "name": "castroom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "tsc --noEmit && tsc --project tsconfig.proxy.json && node scripts/check-proxy.mjs && tsc --project tsconfig.api.json && node scripts/check-api.mjs && vite build --config apps/web/vite.config.ts && tsx scripts/prerender.ts && node scripts/check-prerender.mjs",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "quality:lint": "oxlint --deny-warnings",
    "quality:deadcode": "fallow dead-code",
    "quality:health": "fallow health",
    "test:ui": "playwright test",
    "castroom": "tsx packages/cli/src/main.ts",
    "routine": "node --env-file-if-exists=.env.local --import tsx apps/claude-routine/cli.ts",
    "check:proxy": "tsc --project tsconfig.proxy.json && node scripts/check-proxy.mjs",
    "dev:api": "node --env-file=.env.local --import tsx scripts/dev-api.ts",
    "smoke:engine": "node --env-file=.env.local --import tsx scripts/smoke-engine.ts",
    "check:api": "tsc --project tsconfig.api.json && node scripts/check-api.mjs",
    "test:ui:live": "playwright test -c tests/browser/live.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@castroom/contracts": "workspace:*",
    "@js-temporal/polyfill": "^0.5.1",
    "@mediapipe/tasks-vision": "1.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@remotion/player": "4.0.539",
    "@supabase/supabase-js": "2.119.0",
    "@vercel/functions": "^3.11.3",
    "jose": "^6.2.17",
    "lucide-react": "^0.577.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.539",
    "stripe": "^23.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fallow": "3.41.0",
    "oxlint": "1.92.0",
    "tsx": "4.21.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "packageManager": "pnpm@12.18.0"
}
