{
  "name": "castroom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "tsc --noEmit && tsc --project tsconfig.proxy.json && node scripts/check-proxy.mjs && vite build --config apps/web/vite.config.ts && tsx scripts/prerender.ts && node scripts/check-prerender.mjs",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:ui": "playwright test",
    "castroom": "tsx packages/cli/src/main.ts",
    "check:proxy": "tsc --project tsconfig.proxy.json && node scripts/check-proxy.mjs"
  },
  "dependencies": {
    "@castroom/contracts": "workspace:*",
    "@js-temporal/polyfill": "^0.5.1",
    "@supabase/supabase-js": "2.119.0",
    "@vercel/functions": "^3.11.3",
    "lucide-react": "^0.577.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tsx": "4.21.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "packageManager": "pnpm@12.18.0"
}
