# Copy to .env next to this file. Generate the key with: openssl rand -hex 32
RUNNER_ACCESS_KEY=
# Pages allowed to talk to this runner (comma separated, no trailing slash).
RUNNER_ALLOWED_ORIGINS=https://faceful.dtheo.dev,http://127.0.0.1:5173
# Host port and address. boxd: RUNNER_BIND=0.0.0.0 and RUNNER_PORT=8000 (its HTTPS proxy picks 8000).
RUNNER_BIND=127.0.0.1
RUNNER_PORT=8787
# Cloud saves through apps/workspace-store. STORE_TOKEN opens only this user's folder, until it expires (30 days
# unless told; mint a new one before then): node apps/workspace-store/mint-token.mjs <user-id> [ttl, at most 90d]
STORE_URL=https://faceful-workspace-store.<your-subdomain>.workers.dev
STORE_TOKEN=
# Optional: seals Claude's saved sign-in before it is uploaded, so the store only ever holds ciphertext.
# 32 random bytes: openssl rand -base64 32. Keep it; a new key means signing in to Claude again.
CLAUDE_HOME_KEY=
# VPS only: the domain pointing at this server; Caddy gets its HTTPS certificate.
RUNNER_DOMAIN=claude.example.com
