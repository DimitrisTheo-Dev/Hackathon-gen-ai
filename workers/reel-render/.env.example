# Where the Faceful engine runs (the studio's origin).
FACEFUL_API_URL=https://faceful.dtheo.dev
# Must equal the engine's REEL_WORKER_TOKEN (at least 32 characters, e.g. `openssl rand -hex 32`).
REEL_WORKER_TOKEN=
# The engine's own Supabase project and R2 account (same values as its SUPABASE_URL and FACEFUL_R2_ACCOUNT_ID).
# Media is only fetched from these exact hosts and MEDIA_HOST_ALLOWLIST; without them a render with media fails.
SUPABASE_URL=
FACEFUL_R2_ACCOUNT_ID=
# Optional
# WORKER_ID=vps-1
# POLL_SECONDS=5
# RENDER_CONCURRENCY=4
# Extra hosts linked media may come from, comma separated, exact names (no wildcards). Draft files need nothing here.
# MEDIA_HOST_ALLOWLIST=cdn.example.com
